#!/bin/bash
set -euo pipefail

SELF_NAME="$(basename "$0")"

# Derive hook name: if invoked as .git/hooks/pre-commit, use $0.
# If invoked as run-hook pre-commit, use $1.
if [[ "$SELF_NAME" == "run-hook" ]]; then
  HOOK_NAME="${1:-}"
  shift || true
else
  HOOK_NAME="$SELF_NAME"
fi

if [[ -z "$HOOK_NAME" ]]; then
  echo "[ERROR] Hook name missing." >&2
  exit 1
fi

# Only the installed binary: a path inside the repository, or on PATH, would let a
# cloned repository choose the program that its hooks run.
BIN="$HOME/.local/bin/project-hooks"

if [[ ! -x "$BIN" ]]; then
  echo "[ERROR] project-hooks binary not found." >&2
  echo "[INFO] Install it at ~/.local/bin/project-hooks." >&2
  exit 1
fi

exec "$BIN" "$HOOK_NAME" "$@"
